# Credenciales del entorno LOCAL. Copiar a .env (que no se versiona):
#
#   cp .env.example .env
#
# Este archivo lleva valores de ejemplo a propósito y ninguno sirve fuera de
# la máquina de desarrollo. En cualquier otro entorno estos mismos nombres los
# resuelve el gestor de secretos, no un archivo.

# --- PostgreSQL -------------------------------------------------------------
DB_NAME=reservations
DB_USERNAME=reservations
DB_PASSWORD=reservations
DB_URL=jdbc:postgresql://localhost:5432/reservations

# --- Redis ------------------------------------------------------------------
# El compose publica Redis sólo en loopback y con requirepass. Los dos valores
# tienen que coincidir.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=reservations-local

# --- Catálogo de ciudades ---------------------------------------------------
# Fuera de localhost la URL tiene que ser https://: la API key viaja en un
# header y la aplicación se niega a arrancar si el transporte no va cifrado.
CATALOG_BASE_URL=http://localhost:6070/api/flights/catalog
CATALOG_API_KEY=
CATALOG_DB_ROOT_PASSWORD=muppet

# --- Autenticación ----------------------------------------------------------
# En local se usan tokens HMAC firmados con la clave de desarrollo que trae
# application.yml. En cualquier otro entorno:
#
#   SECURITY_DEV_TOKENS=false
#   JWT_JWK_SET_URI=https://idp.edteam.example/.well-known/jwks.json
#   JWT_ISSUER=https://idp.edteam.example
#   JWT_AUDIENCE=reservations-api
#
# Sin jwk-set-uri y con dev-tokens en false, la aplicación no arranca: no hay
# ninguna combinación que produzca una API sin validar tokens.
SECURITY_DEV_TOKENS=true
JWT_JWK_SET_URI=
JWT_ISSUER=
JWT_AUDIENCE=

# --- Cifrado de datos personales --------------------------------------------
# Clave AES-256 en Base64 con la que se cifra el documento del pasajero.
# Generar una propia por entorno:
#
#   openssl rand -base64 32
#
# Rotarla no es cambiar esta línea: el formato de la columna lleva prefijo de
# versión para poder convivir con dos claves durante la rotación.
PII_ENCRYPTION_KEY=ZGV2LW9ubHkta2V5LTMyLWJ5dGVzLWRlbW8tMDEyMzQ=

# --- Superficie expuesta ----------------------------------------------------
# El documento y Swagger UI están apagados por defecto: el mapa completo de la
# API le ahorra la mitad del trabajo a quien la esté explorando, y una UI que
# ejecuta pedidos reales contra producción no va abierta.
#
# Encendidos se sirven SIN token —exigirlo dejaría la UI inusable, porque una
# navegación del navegador no lleva header Authorization—, así que el
# interruptor es el control: en producción estos dos quedan en false y el
# contrato se publica desde docs/api/openapi.yaml.
#
# Lo que la UI ejecuta sí exige token: hay que pegar un Bearer en 'Authorize'.
API_DOCS_ENABLED=true
SWAGGER_UI_ENABLED=true
# Actuator en un puerto propio, que el despliegue no publica hacia afuera.
MANAGEMENT_PORT=9090
# CORS: allowlist explícita por entorno, separada por comas. Vacía lo apaga.
CORS_ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# RabbitMQ (mensajería)
# ---------------------------------------------------------------------------
# Broker al que el relay del outbox publica los hechos de negocio. La
# aplicación arranca sin él: los eventos se acumulan en la tabla
# outbox_message y salen cuando el broker vuelve.
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USERNAME=reservations
RABBIT_PASSWORD=reservations-local

# En false queda el publicador que sólo loguea. Correcto en local y en los
# tests; en cualquier otro entorno es una pérdida silenciosa de notificaciones.
MESSAGING_ENABLED=true

# Sólo en local: declara también las colas del consumidor para que el circuito
# quede completo con 'docker compose up'. En cualquier otro entorno, false.
MESSAGING_DECLARE_CONSUMER_TOPOLOGY=true

# Consumidor de referencia de este repositorio. En producción el consumidor es
# el servicio de notificaciones y esto va en false.
MESSAGING_CONSUMER_ENABLED=true

# Identifica al emisor en el envelope. Cambiarlo por entorno es lo que evita
# que un mensaje de staging se procese como productivo.
MESSAGING_SOURCE=urn:edteam:flight-reservations

# ---------------------------------------------------------------------------
# Grafana (profile 'observability')
# ---------------------------------------------------------------------------
# Credencial del administrador de Grafana. Se entra igual sin login como
# Viewer —para mirar los paneles no hace falta nada— y esto es lo que permite
# EDITAR: explorar datasources, cambiar una consulta o guardar una copia de un
# panel.
#
# Sólo aplica al contenedor del profile 'observability', que publica en
# 127.0.0.1:3000. En cualquier entorno real Grafana va detrás del SSO de la
# organización y estas dos variables no existen.
GRAFANA_USERNAME=admin
GRAFANA_PASSWORD=reservations-local

# Acceso anónimo de sólo lectura. En false hay que iniciar sesión para ver
# cualquier cosa; es lo correcto en cualquier entorno que no sea la máquina de
# uno.
GRAFANA_ANONYMOUS=true
