<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.edteam</groupId>
    <artifactId>flight-reservations</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>flight-reservations</name>
    <description>Sistema de reservas de vuelos - esqueleto con arquitectura hexagonal</description>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.2.1</archunit.version>
        <!--
          Línea 2.8.x: es la que acompaña a Spring Boot 3.5. La 3.x ya apunta a
          Boot 4 / Spring Framework 7 y no arranca con este parent.
        -->
        <springdoc.version>2.8.17</springdoc.version>
        <!--
          Resilience4j 2.2.0: última de la línea 2.x, compilada para Java 17+ y
          sin dependencias de Spring. Versión fija y no un rango: el umbral de
          un circuito es una decisión de diseño y no puede cambiar de semántica
          en un build reproducible. Licencia Apache 2.0, sin servicio externo
          ni plan pago.
        -->
        <resilience4j.version>2.2.0</resilience4j.version>
        <!--
          logstash-logback-encoder: el encoder JSON del esquema de log. Versión
          FIJA y no un rango, y declarada acá porque el BOM de Spring Boot no la
          administra. El esquema del log es un contrato —hay consultas, paneles
          y alertas escritos contra sus nombres de campo— y los providers por
          defecto de esta librería cambian entre versiones mayores: un upgrade
          silencioso renombraría campos sin que falle nada hasta el día del
          incidente. La 8.1 es la línea que acompaña a Logback 1.5.x, que es lo
          que trae Boot 3.5. Licencia Apache 2.0 / MIT, sin servicio externo.
        -->
        <logstash.encoder.version>8.1</logstash.encoder.version>
        <exec.plugin.version>3.5.0</exec.plugin.version>

        <!--
          JaCoCo: el agente que mide qué líneas ejecuta la suite. Hace falta
          porque Sonar NO mide cobertura: la importa. Sin un jacoco.xml que
          leer, el análisis sube igual y publica 0,0% — que es peor que no
          publicar nada, porque es un número que parece medido.
        -->
        <jacoco.version>0.8.15</jacoco.version>

        <!--
          El escáner de Sonar. Versión FIJA por el mismo motivo que el resto de
          este pom: el análisis produce un número con el que se bloquean pull
          requests, y ese número no puede cambiar de definición porque alguien
          publicó una versión nueva un martes.
        -->
        <sonar.plugin.version>5.8.0.7211</sonar.plugin.version>

        <!--
          Spotless: el formateador. 'spotless:check' falla si un archivo no
          está como el formateador lo dejaría; 'spotless:apply' lo arregla.
          Que la misma herramienta verifique y corrija es el punto: un linter
          que sólo señala genera discusión sobre el estilo, y uno que además
          formatea la termina.
        -->
        <spotless.version>3.10.2</spotless.version>

        <!--
          palantir-java-format y NO google-java-format, que es el default de
          casi todos los ejemplos.

          El motivo es medible: este código está escrito con sangría de 4
          espacios y el percentil 99 de largo de línea es 107 caracteres.
          google-java-format impone 2 espacios y 100 columnas, o sea que
          reformatearía absolutamente todas las líneas de los 328 archivos.
          palantir usa 4 espacios y 120 columnas —la convención con la que el
          código ya está escrito— y el reformateo se limita a lo que de verdad
          estaba inconsistente.

          Ninguno de los dos es configurable, y eso también es a propósito: un
          formateador con opciones es una discusión de estilo esperando a
          ocurrir.
        -->
        <palantir.format.version>2.99.0</palantir.format.version>

        <!--
          CycloneDX: escribe el SBOM del proyecto — el árbol de dependencias
          RESUELTO, transitivas incluidas, con las coordenadas Maven exactas de
          cada una.

          POR QUÉ HAY UN SBOM Y NO SÓLO UN ESCÁNER
          Un escáner que mira un DIRECTORIO no sirve acá: un checkout limpio de
          este repositorio tiene CERO archivos .jar (el wrapper es
          'distributionType=only-script'), así que no encontraría un solo
          artefacto Java y reportaría que no hay nada — un check verde que no
          probó nada. El SBOM invierte el problema: lo produce Maven, que sí
          sabe qué se resuelve, y el escáner pasa a leer una lista exacta en vez
          de adivinar mirando el disco.

          'includeTestScope' queda en false, que es su default: una CVE en
          Testcontainers, en JUnit o en assertj no se corrige, porque nada de
          eso entra a la imagen — el Dockerfile copia el classpath de ejecución
          y nada más. Es el mismo criterio que 'skipTestScope' en
          Dependency-Check, y por eso los dos escaneos miran el mismo conjunto.

          El SBOM además se publica como artefacto de la corrida: es lo que hace
          falta el día que se publica una CVE y hay que contestar «¿esta versión
          la tiene?» sin reconstruir nada.
        -->
        <cyclonedx.version>2.9.3</cyclonedx.version>

        <!--
          OWASP Dependency-Check: cruza el árbol de dependencias resuelto
          contra la base de vulnerabilidades del NVD.

          YA NO ES EL GATE DEL PULL REQUEST. Lo es Trivy, que lee el SBOM de
          CycloneDX y tarda segundos. Dependency-Check quedó en un workflow
          NOCTURNO ('.github/workflows/security-nightly.yml') por una razón que
          no es la velocidad sino la cobertura, y las dos herramientas no ven lo
          mismo:

            · Trivy identifica cada dependencia por sus COORDENADAS declaradas
              (groupId:artifactId:version). Es exacto y casi no produce falsos
              positivos, pero no ve un jar que embebió otro jar adentro
              (shading, vendoring): para Trivy ese contenido no existe.

            · Dependency-Check identifica por HUELLA (hash, metadatos, nombre
              del archivo). Ve lo embebido, y ése es exactamente el punto ciego
              del otro. El precio es la base del NVD —cientos de megas que hay
              que bajar e indexar— y una tasa de falsos positivos bastante más
              alta.

          Poner al lento en el camino crítico de cada pull request para cubrir
          un caso poco frecuente es lo que hace que un pipeline se esquive.
          Corriendo de noche contra 'main', la cobertura se conserva y el costo
          lo paga un runner que nadie está esperando.

          Se usa el PLUGIN DE MAVEN y no la CLI por lo mismo que se genera un
          SBOM: el plugin corre dentro de Maven y ve el árbol resuelto.
        -->
        <dependency.check.version>13.0.0</dependency.check.version>

        <!--
          Coordenadas del proyecto en SonarQube Cloud. Van acá y no en el
          workflow para que 'sonar:sonar' se pueda correr a mano contra el
          mismo proyecto, y para que no haya dos lugares donde equivocarse.
          Lo único que NO está acá es el token.
        -->
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
        <sonar.organization>adschosen-github</sonar.organization>
        <sonar.projectKey>andres-sacco_edteam-architecture-with-ai</sonar.projectKey>

        <!--
          De dónde lee Sonar la cobertura. Es el informe MEZCLADO de unitarios
          y de integración: apuntarlo sólo al de surefire descontaría todo lo
          que cubren los *IT —que son los que ejercitan los adaptadores de
          salida contra PostgreSQL y RabbitMQ reales— y dejaría a la capa de
          infraestructura pareciendo sin tests.
        -->
        <sonar.coverage.jacoco.xmlReportPaths>${project.build.directory}/site/jacoco-merged/jacoco.xml</sonar.coverage.jacoco.xmlReportPaths>

        <!--
          De dónde lee Sonar los RESULTADOS de los tests (cuántos corrieron,
          cuántos fallaron, cuánto tardaron). El default es sólo
          'target/surefire-reports': sin nombrar también el de failsafe, los
          148 tests de integración no se contarían y el panel diría que el
          proyecto tiene 650 tests en vez de 798.

          No se declara 'sonar.exclusions' para las clases de test: en un
          proyecto Maven, Sonar ya deriva 'sonar.sources' de src/main y
          'sonar.tests' de src/test del propio POM, y las analiza con reglas
          distintas. Excluirlas a mano sólo lograría que dejaran de analizarse
          como tests.
        -->
        <sonar.junit.reportPaths>${project.build.directory}/surefire-reports,${project.build.directory}/failsafe-reports</sonar.junit.reportPaths>
        <!-- El gate de PII necesita 'sh'. Se apaga con -Dpii.gate.skip=true. -->
        <pii.gate.skip>false</pii.gate.skip>
    </properties>

    <dependencies>
        <!--
          Starter web: levanta Tomcat embebido y sirve los endpoints del
          adaptador REST de entrada en el puerto configurado (8080).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          Bean Validation: valida los DTOs de entrada de forma declarativa, de
          modo que un pedido malformado se rechace con 400 en el borde y no
          llegue nunca al caso de uso.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Seguridad: la cadena de filtros del borde. Trae el 'denyAll' por
          defecto, los headers de seguridad y el punto donde se decide quién
          llega a cada endpoint.

          La autorización por recurso —quién puede ver o tocar QUÉ reserva— no
          está acá: es una regla de negocio y vive en el dominio
          (ReservationAccessPolicy). HexagonalArchitectureTest verifica que
          ninguna clase de Spring Security se filtre hacia adentro.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
          Resource server OAuth2: valida el token Bearer contra el JWKS del
          emisor. Se eligió resource server y no un esquema propio porque la
          API la consumen varios frontends y partners: la emisión de
          credenciales es problema del proveedor de identidad, y este servicio
          sólo verifica firmas que no puede falsificar.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
          springdoc: genera el documento OpenAPI a partir de los controllers,
          los DTOs y sus anotaciones de validación, y publica Swagger UI para
          explorarlo y probarlo desde el navegador.

          El starter '-ui' trae también el '-api', así que el documento queda
          disponible aunque se apague la interfaz (springdoc.swagger-ui.enabled).
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
          Persistencia: JPA/Hibernate sobre PostgreSQL. Trae spring-tx, así que
          los @Transactional de los casos de uso ahora sí demarcan transacciones
          reales (antes eran inertes por falta de TransactionManager).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Migraciones versionadas: el esquema lo gobierna Flyway, no Hibernate. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
          Redis (Lettuce): soporte del cache distribuido. Está en el classpath
          siempre, pero el adaptador que lo usa se cablea sólo si
          'reservations.cache.redis.enabled' es true; sin eso, el cache es el
          fallback en memoria y la aplicación arranca sin Redis, igual que
          arranca sin el catálogo externo.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          AMQP (RabbitMQ): el cliente del broker. Está en el classpath siempre,
          pero el publicador real se cablea sólo si
          'reservations.messaging.enabled' es true; sin eso queda el publicador
          que loguea y la aplicación arranca sin broker, igual que arranca sin
          Redis y sin el catálogo externo.

          El cliente no cruza hacia adentro: HexagonalArchitectureTest verifica
          que ni 'domain' ni 'application' dependan de org.springframework.amqp
          ni de com.rabbitmq.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!--
          Resiliencia: SÓLO los módulos base. No se agrega
          'resilience4j-spring-boot3' a propósito: ese módulo trae AOP y las
          anotaciones @CircuitBreaker/@Retry, y una anotación de resiliencia en
          un servicio de aplicación es exactamente lo que este diseño no quiere
          que pueda existir. Con los módulos base los circuitos se cablean a
          mano en 'infrastructure.config', igual que los decoradores de cache y
          de reintentos, y HexagonalArchitectureTest verifica que la librería no
          se filtre hacia adentro.
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-bulkhead</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <!--
          Publica el estado y las transiciones de cada circuito como series de
          Micrometer. Sin esto, un circuito abierto sólo se ve en los logs, que
          es lo mismo que no verlo.
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!--
          Registro de Prometheus. '/actuator/metrics' devuelve un medidor por
          vez en JSON: sirve para mirar, no para alertar. El scrape se publica
          en el puerto de gestión, que sigue sin exponerse hacia afuera: lo que
          se abre es la lectura de métricas, no la superficie de la API.
          La versión la fija el BOM de Spring Boot.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
          Encoder JSON para Logback. Es lo único que hace falta para que el
          esquema del §1 del diseño salga como un objeto por línea: los
          providers se declaran uno por uno en logback-spring.xml, no se
          heredan los defaults.

          Vive en 'infrastructure' por construcción: ninguna clase del código
          la importa. La capa de aplicación escribe pares clave/valor con
          org.slf4j y no sabe que el destino es JSON; HexagonalArchitectureTest
          lo verifica.
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash.encoder.version}</version>
        </dependency>

        <!--
          Trazas: el bridge de OpenTelemetry para Micrometer Tracing más el
          exportador OTLP. Las versiones las fija el BOM de Boot.

          Dos cosas que esto compra y que el correlationId no puede dar: el
          gráfico de tiempos del fan-out de hasta 8 ciudades en paralelo (§5.1
          del diseño) y la propagación W3C 'traceparent' hacia el catálogo.

          El EXPORTADOR está apagado por defecto
          ('management.tracing.export.enabled: false'): sin esto, una
          aplicación sin Tempo levantado reintenta contra localhost:4318 y
          llena el log de errores del propio sistema de observabilidad. Se
          enciende junto con el profile 'observability' del compose.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!--
          Propagación de contexto a hilos que no son el del pedido. Es lo que
          arregla el hueco 1 del §0 del diseño y el hallazgo 11 de la
          auditoría: 'CompletableFuture.supplyAsync(..., workers)' sobre hilos
          virtuales no lleva ni el MDC ni el contexto de traza, así que las 14
          líneas del catálogo salían sin correlationId — justo las que se
          buscan cuando un POST sale degradado.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Utilidades de test de Spring Security: los post-processors que
          inyectan una autenticación en un pedido de MockMvc. Es lo que permite
          probar el 401, el 403 y —sobre todo— que el 404 de una reserva ajena
          sea indistinguible del de una inexistente.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test de arquitectura: verifica que las dependencias entre capas no se violen. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          Testcontainers: los tests de integración corren contra un PostgreSQL
          real en Docker, que es la única forma de validar de verdad las
          migraciones de Flyway, los UNIQUE y el locking optimista. Van en la
          fase verify (failsafe) para que 'mvn test' siga sin necesitar Docker.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Awaitility: los tests del consumidor esperan un efecto que ocurre en
          OTRO hilo (el contenedor de listeners). Sin esto habría que poner
          Thread.sleep con un margen generoso, que es lento cuando pasa e
          intermitente cuando no. La versión la fija el BOM de Spring Boot.
        -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          RabbitMQ real en Docker para los tests de integración de mensajería.
          Es la única forma de validar lo que importa del broker y no se puede
          simular: los publisher confirms, el 'mandatory' sobre un exchange sin
          bindings, la TTL de la cola de espera y el dead-lettering. Va en la
          fase verify, como el de PostgreSQL, para que 'mvn test' siga sin
          necesitar Docker.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!--
                      build-info: escribe META-INF/build-info.properties con la
                      versión y el instante del build. Es de dónde sale el campo
                      'version' obligatorio de cada registro de log (§1.2 del
                      diseño) y el 'version' de /actuator/info.

                      Sale del build y no de una constante a propósito: una
                      constante se olvida de actualizar y el log empieza a
                      mentir sobre qué artefacto produjo la línea, que es
                      justamente el dato con el que se decide si un incidente
                      lo introdujo el último despliegue.
                    -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              'mvn test' corre sólo los unitarios (*Test): rápidos y sin Docker.
              'mvn verify' agrega los de integración (*IT), que necesitan Docker.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!--
                      La salida de los tests va a archivo además de a consola.
                      Es lo que le da al gate de datos sensibles algo que
                      revisar: sin esto, la única forma de verificar que la
                      suite no escribe un email en claro es mirarla pasar, que
                      es exactamente lo que la auditoría hizo a mano y lo que
                      este paso viene a convertir en un paso del build.
                    -->
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                </configuration>
            </plugin>
            <!--
              El gate de datos sensibles, como paso de 'verify'.
              
              Corre DESPUÉS de failsafe —fase 'verify', que es la que sigue a
              'integration-test'— para poder mirar la salida de los tests de
              integración además de la de los unitarios.
              
              Los tests con ListAppender afirman sobre los registros que UNA
              prueba provoca; esto mira TODO lo que la suite escribió, incluido
              el arranque del contexto y las líneas que nadie está asertando.
              Son dos redes distintas y hacen falta las dos.
              
              'skip' con -Dpii.gate.skip=true para las plataformas sin 'sh'.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <executions>
                    <execution>
                        <id>pii-log-gate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${pii.gate.skip}</skip>
                            <executable>sh</executable>
                            <arguments>
                                <argument>${project.basedir}/scripts/pii-log-gate.sh</argument>
                                <argument>${project.build.directory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              Cobertura, en dos mediciones y un informe.

              Hacen falta DOS agentes y no uno porque surefire y failsafe
              forkean JVMs distintas y cada una escribe su propio .exec. Con un
              solo 'prepare-agent', 'mvn verify' mide los unitarios y pierde
              todo lo que cubren los 148 tests de integración — que son
              justamente los que ejercitan los adaptadores contra PostgreSQL y
              RabbitMQ reales. El informe resultante mostraría la capa de
              infraestructura casi sin cubrir y la conclusión sería la
              contraria a la verdadera.

              El orden importa: 'merge' y 'report' están los dos en la fase
              'verify' y Maven los ejecuta en el orden en que están declarados
              acá. Al revés, 'report' leería un archivo mezclado que todavía no
              existe. Y los dos van DESPUÉS de failsafe en este pom, que es lo
              que garantiza que jacoco-it.exec ya esté escrito.

              Los dos agentes escriben en la MISMA propiedad 'argLine', que es
              el default, y no en dos propiedades distintas. No es pereza de
              configuración: es el único camino que funciona.

              Si se declara un <propertyName> propio y se lo referencia desde
              <argLine> de surefire, hay que declarar además esa propiedad en
              <properties> para que un build con -Djacoco.skip no reviente con
              el literal sin resolver... y esa declaración es exactamente lo
              que rompe el mecanismo: Maven interpola <argLine> contra
              <properties> al CONSTRUIR EL MODELO, mucho antes de que
              'prepare-agent' exista, así que surefire forkea con un argLine
              vacío. El síntoma es silencioso y cuesta ver: el log dice
              "argLine set to -javaagent:..." y después "Skipping JaCoCo
              execution due to missing execution data file", el build queda en
              verde y Sonar publica 0,0% de cobertura.

              Con el default no se toca <argLine> en ningún lado: surefire y
              failsafe leen la propiedad 'argLine' del proyecto en tiempo de
              ejecución. 'prepare-agent' la fija en 'initialize' (la usa
              surefire, fase 'test') y 'prepare-agent-integration' la pisa en
              'pre-integration-test' (la usa failsafe, fase
              'integration-test'). Los dos llegan a tiempo y cada uno escribe
              su propio .exec.
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-unitarios</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-ut.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-integracion</id>
                        <goals>
                            <goal>prepare-agent-integration</goal>
                        </goals>
                        <configuration>
                            <destFile>${project.build.directory}/jacoco-it.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-merge</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>merge</goal>
                        </goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.build.directory}</directory>
                                    <includes>
                                        <include>jacoco-*.exec</include>
                                    </includes>
                                </fileSet>
                            </fileSets>
                            <!--
                              El destino NO se llama 'jacoco-*.exec' a
                              propósito: con ese nombre entraría en su propio
                              patrón de entrada y cada corrida se mezclaría con
                              el resultado de la anterior, arrastrando
                              cobertura de código que ya no existe.
                            -->
                            <destFile>${project.build.directory}/merged.exec</destFile>
                        </configuration>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                        <configuration>
                            <dataFile>${project.build.directory}/merged.exec</dataFile>
                            <outputDirectory>${project.build.directory}/site/jacoco-merged</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!--
              Formato del código.

              NO está atado a ninguna fase. Podría estarlo —es rápido y no
              habla con ningún servicio— pero entonces 'mvn test' fallaría por
              una llave mal puesta, y en el pipeline el trabajo "Tests
              unitarios" aparecería en rojo por un problema que no es de
              tests. Un fallo mal atribuido cuesta más que el que se tarda en
              encontrarlo: se convierte en "los tests están flaky".

              Corre entonces como su propio paso ('./mvnw spotless:check'), en
              su propio trabajo del pipeline, y lo que dice rojo ahí es
              exactamente "el formato".

              Para arreglarlo: ./mvnw spotless:apply
            -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir.format.version}</version>
                        </palantirJavaFormat>
                        <!--
                          palantir no borra imports sin usar: sólo ordena y
                          acomoda. Un import muerto es código muerto y el
                          compilador no lo señala, así que esto es lo único
                          del bloque que además de formato arregla contenido.
                        -->
                        <removeUnusedImports/>
                    </java>

                    <!--
                      El resto de los archivos de texto. Hoy están todos
                      limpios, así que esto no cambia nada: está para que siga
                      siendo cierto. Un espacio al final de una línea no se ve
                      en ningún editor y ensucia todos los diffs que la tocan
                      después.
                    -->
                    <formats>
                        <format>
                            <includes>
                                <include>*.md</include>
                                <include>docs/**/*.md</include>
                                <include>scripts/**/*.sh</include>
                                <include>scripts/**/*.py</include>
                                <include>.github/**/*.yml</include>
                                <include>src/main/resources/**/*.sql</include>
                            </includes>
                            <excludes>
                                <!--
                                  docs/api/openapi.yaml NO entra, y no es un
                                  descuido: lo REGENERA OpenApiDocumentDumpTest
                                  desde springdoc, y el pipeline compara el
                                  archivo commiteado contra el regenerado byte
                                  a byte. Si Spotless le normalizara algo,
                                  springdoc volvería a emitirlo sin normalizar
                                  y esa comparación fallaría para siempre, sin
                                  que nadie haya tocado la API. Lo mismo vale
                                  para cualquier otro archivo generado que se
                                  agregue después.
                                -->
                                <exclude>docs/api/openapi.yaml</exclude>
                            </excludes>
                            <trimTrailingWhitespace/>
                            <endWithNewline/>
                        </format>
                    </formats>
                </configuration>
            </plugin>
            <!--
              El SBOM: la lista exacta de lo que entra a la imagen.

              NO está atado a ninguna fase. Se invoca explícitamente
              ('./mvnw cyclonedx:makeAggregateBom') y no compila nada: resuelve
              el árbol de dependencias y lo escribe. Atarlo a 'package' haría
              que cada build local pagara la resolución completa para producir
              un archivo que sólo consume el escáner.

              'makeAggregateBom' y no 'makeBom': el primero agrega los módulos
              del reactor. Hoy hay uno solo y dan lo mismo; el día que haya dos,
              'makeBom' dejaría la mitad del árbol afuera sin que nada falle.

              El escáner que lo lee es Trivy, y el umbral con el que falla está
              en 'trivy.yaml' — no acá y no en el workflow. Ese archivo es lo
              que hace que

                  trivy sbom target/bom.json

              a mano dé exactamente el mismo veredicto que el CI.
            -->
            <plugin>
                <groupId>org.cyclonedx</groupId>
                <artifactId>cyclonedx-maven-plugin</artifactId>
                <version>${cyclonedx.version}</version>
                <configuration>
                    <!--
                      JSON y no XML: es lo que lee Trivy sin conversiones, y es
                      lo que se puede diffear entre dos corridas para ver qué
                      dependencia entró o cambió de versión.
                    -->
                    <outputFormat>json</outputFormat>
                    <outputDirectory>${project.build.directory}</outputDirectory>
                    <outputName>bom</outputName>
                    <!--
                      El default ya es false; está explícito porque es una
                      decisión, no una omisión. Ver el comentario de
                      'cyclonedx.version' arriba.
                    -->
                    <includeTestScope>false</includeTestScope>
                    <!--
                      Sin esto el plugin escribe una línea por dependencia
                      resuelta: varios cientos de líneas de ruido en el log del
                      CI, arriba de lo único que hay que leer ahí.
                    -->
                    <verbose>false</verbose>
                </configuration>
            </plugin>
            <!--
              Vulnerabilidades conocidas en las dependencias, por HUELLA.

              Esto ya no corre en el pipeline de cada pull request: corre de
              noche contra 'main' ('.github/workflows/security-nightly.yml').
              El porqué está en el comentario de 'dependency.check.version',
              arriba, y se resume en que ve lo que Trivy no ve —jars embebidos
              dentro de otros jars— a cambio de bajar e indexar la base del NVD.

              NO está atado a ninguna fase, por lo mismo que el escáner de
              Sonar: cada 'mvn verify' local intentaría hablar con el NVD y
              descargar una base de datos de cientos de megas. Se invoca
              explícitamente ('./mvnw dependency-check:check').

              QUÉ SE ESCANEA Y QUÉ NO
              'skipTestScope' queda en su default (true): una CVE en
              Testcontainers, en JUnit o en assertj no se corrige, porque nada
              de eso entra a la imagen — el Dockerfile copia el classpath de
              ejecución y nada más. Marcarlas rojas sería ruido que enseña a
              ignorar el informe entero, que es el único modo real en que un
              gate de seguridad se rompe.

              POR QUÉ FALLA EL BUILD Y NO SÓLO INFORMA
              Un informe que nadie tiene que mirar no se mira. Con
              'failBuildOnCVSS' en 7 (el piso de "High" en CVSS v3), una
              dependencia con una vulnerabilidad alta o crítica pone el trabajo
              en rojo. La salida correcta cuando eso pasa es subir la versión
              de la dependencia o, si es un falso positivo, suprimirlo POR
              ESCRITO en owasp-suppressions.xml, con su motivo y su fecha. La
              salida incorrecta es subir este número.
            -->
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>${dependency.check.version}</version>
                <configuration>
                    <!--
                      HTML para leer, JSON para que lo parsee el paso que
                      escribe el resumen del workflow. Sin el JSON, la única
                      forma de saber qué falló es bajar el artefacto y abrirlo
                      en un navegador.
                    -->
                    <formats>
                        <format>HTML</format>
                        <format>JSON</format>
                    </formats>
                    <outputDirectory>${project.build.directory}/dependency-check</outputDirectory>
                    <!--
                      La base del NVD, FUERA de '~/.m2/repository'. Su lugar por
                      defecto está adentro, y eso hacía que la caché del
                      repositorio Maven —la que administra 'setup-java', que
                      comparten todos los trabajos— se llevara puestos varios
                      gigabytes de base de vulnerabilidades en cada corrida. Dos
                      cachés sobre la misma ruta no se suman: se desalojan.
                    -->
                    <dataDirectory>${user.home}/.cache/dependency-check</dataDirectory>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                    <suppressionFiles>
                        <suppressionFile>${project.basedir}/owasp-suppressions.xml</suppressionFile>
                    </suppressionFiles>
                    <!--
                      La clave del NVD, leída del ENTORNO y no de un -D en la
                      línea de comandos: un -D queda en el argv del proceso y
                      lo ve cualquier cosa que liste procesos en el runner.
                      Sin clave, el NVD limita el ritmo a un punto en que la
                      descarga inicial tarda entre treinta y sesenta minutos y
                      falla seguido; con clave son un par de minutos.
                    -->
                    <nvdApiKey>${env.NVD_API_KEY}</nvdApiKey>
                    <!--
                      Analizadores que no aportan nada acá y cuestan tiempo:
                      este proyecto no tiene .NET, ni Node, ni Ruby, ni Python.
                    -->
                    <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                    <nodeAnalyzerEnabled>false</nodeAnalyzerEnabled>
                    <retireJsAnalyzerEnabled>false</retireJsAnalyzerEnabled>
                </configuration>
            </plugin>
            <!--
              El escáner de Sonar. NO está atado a ninguna fase: se invoca
              explícitamente ('./mvnw sonar:sonar') después de que el build
              produjo las clases y la cobertura. Atarlo a una fase haría que
              cada 'mvn verify' local intentara hablar con sonarcloud.io y
              fallara por falta de token.
            -->
            <plugin>
                <groupId>org.sonarsource.scanner.maven</groupId>
                <artifactId>sonar-maven-plugin</artifactId>
                <version>${sonar.plugin.version}</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <!-- Se excluye 'serial': estas excepciones no se serializan. -->
                        <arg>-Xlint:all,-serial</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
