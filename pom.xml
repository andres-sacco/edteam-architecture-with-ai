<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>com.edteam</groupId>
    <artifactId>flight-reservations</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>flight-reservations</name>
    <description>Sistema de reservas de vuelos - esqueleto con arquitectura hexagonal</description>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.2.1</archunit.version>
        <!--
          Línea 2.8.x: es la que acompaña a Spring Boot 3.5. La 3.x ya apunta a
          Boot 4 / Spring Framework 7 y no arranca con este parent.
        -->
        <springdoc.version>2.8.17</springdoc.version>
        <!--
          Resilience4j 2.2.0: última de la línea 2.x, compilada para Java 17+ y
          sin dependencias de Spring. Versión fija y no un rango: el umbral de
          un circuito es una decisión de diseño y no puede cambiar de semántica
          en un build reproducible. Licencia Apache 2.0, sin servicio externo
          ni plan pago.
        -->
        <resilience4j.version>2.2.0</resilience4j.version>
        <!--
          logstash-logback-encoder: el encoder JSON del esquema de log. Versión
          FIJA y no un rango, y declarada acá porque el BOM de Spring Boot no la
          administra. El esquema del log es un contrato —hay consultas, paneles
          y alertas escritos contra sus nombres de campo— y los providers por
          defecto de esta librería cambian entre versiones mayores: un upgrade
          silencioso renombraría campos sin que falle nada hasta el día del
          incidente. La 8.1 es la línea que acompaña a Logback 1.5.x, que es lo
          que trae Boot 3.5. Licencia Apache 2.0 / MIT, sin servicio externo.
        -->
        <logstash.encoder.version>8.1</logstash.encoder.version>
        <exec.plugin.version>3.5.0</exec.plugin.version>
        <!-- El gate de PII necesita 'sh'. Se apaga con -Dpii.gate.skip=true. -->
        <pii.gate.skip>false</pii.gate.skip>
    </properties>

    <dependencies>
        <!--
          Starter web: levanta Tomcat embebido y sirve los endpoints del
          adaptador REST de entrada en el puerto configurado (8080).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
          Bean Validation: valida los DTOs de entrada de forma declarativa, de
          modo que un pedido malformado se rechace con 400 en el borde y no
          llegue nunca al caso de uso.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
          Seguridad: la cadena de filtros del borde. Trae el 'denyAll' por
          defecto, los headers de seguridad y el punto donde se decide quién
          llega a cada endpoint.

          La autorización por recurso —quién puede ver o tocar QUÉ reserva— no
          está acá: es una regla de negocio y vive en el dominio
          (ReservationAccessPolicy). HexagonalArchitectureTest verifica que
          ninguna clase de Spring Security se filtre hacia adentro.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!--
          Resource server OAuth2: valida el token Bearer contra el JWKS del
          emisor. Se eligió resource server y no un esquema propio porque la
          API la consumen varios frontends y partners: la emisión de
          credenciales es problema del proveedor de identidad, y este servicio
          sólo verifica firmas que no puede falsificar.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
          springdoc: genera el documento OpenAPI a partir de los controllers,
          los DTOs y sus anotaciones de validación, y publica Swagger UI para
          explorarlo y probarlo desde el navegador.

          El starter '-ui' trae también el '-api', así que el documento queda
          disponible aunque se apague la interfaz (springdoc.swagger-ui.enabled).
        -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!--
          Persistencia: JPA/Hibernate sobre PostgreSQL. Trae spring-tx, así que
          los @Transactional de los casos de uso ahora sí demarcan transacciones
          reales (antes eran inertes por falta de TransactionManager).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Migraciones versionadas: el esquema lo gobierna Flyway, no Hibernate. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!--
          Redis (Lettuce): soporte del cache distribuido. Está en el classpath
          siempre, pero el adaptador que lo usa se cablea sólo si
          'reservations.cache.redis.enabled' es true; sin eso, el cache es el
          fallback en memoria y la aplicación arranca sin Redis, igual que
          arranca sin el catálogo externo.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!--
          AMQP (RabbitMQ): el cliente del broker. Está en el classpath siempre,
          pero el publicador real se cablea sólo si
          'reservations.messaging.enabled' es true; sin eso queda el publicador
          que loguea y la aplicación arranca sin broker, igual que arranca sin
          Redis y sin el catálogo externo.

          El cliente no cruza hacia adentro: HexagonalArchitectureTest verifica
          que ni 'domain' ni 'application' dependan de org.springframework.amqp
          ni de com.rabbitmq.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>

        <!--
          Resiliencia: SÓLO los módulos base. No se agrega
          'resilience4j-spring-boot3' a propósito: ese módulo trae AOP y las
          anotaciones @CircuitBreaker/@Retry, y una anotación de resiliencia en
          un servicio de aplicación es exactamente lo que este diseño no quiere
          que pueda existir. Con los módulos base los circuitos se cablean a
          mano en 'infrastructure.config', igual que los decoradores de cache y
          de reintentos, y HexagonalArchitectureTest verifica que la librería no
          se filtre hacia adentro.
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-bulkhead</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>
        <!--
          Publica el estado y las transiciones de cada circuito como series de
          Micrometer. Sin esto, un circuito abierto sólo se ve en los logs, que
          es lo mismo que no verlo.
        -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!--
          Registro de Prometheus. '/actuator/metrics' devuelve un medidor por
          vez en JSON: sirve para mirar, no para alertar. El scrape se publica
          en el puerto de gestión, que sigue sin exponerse hacia afuera: lo que
          se abre es la lectura de métricas, no la superficie de la API.
          La versión la fija el BOM de Spring Boot.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
          Encoder JSON para Logback. Es lo único que hace falta para que el
          esquema del §1 del diseño salga como un objeto por línea: los
          providers se declaran uno por uno en logback-spring.xml, no se
          heredan los defaults.

          Vive en 'infrastructure' por construcción: ninguna clase del código
          la importa. La capa de aplicación escribe pares clave/valor con
          org.slf4j y no sabe que el destino es JSON; HexagonalArchitectureTest
          lo verifica.
        -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>${logstash.encoder.version}</version>
        </dependency>

        <!--
          Trazas: el bridge de OpenTelemetry para Micrometer Tracing más el
          exportador OTLP. Las versiones las fija el BOM de Boot.

          Dos cosas que esto compra y que el correlationId no puede dar: el
          gráfico de tiempos del fan-out de hasta 8 ciudades en paralelo (§5.1
          del diseño) y la propagación W3C 'traceparent' hacia el catálogo.

          El EXPORTADOR está apagado por defecto
          ('management.tracing.export.enabled: false'): sin esto, una
          aplicación sin Tempo levantado reintenta contra localhost:4318 y
          llena el log de errores del propio sistema de observabilidad. Se
          enciende junto con el profile 'observability' del compose.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!--
          Propagación de contexto a hilos que no son el del pedido. Es lo que
          arregla el hueco 1 del §0 del diseño y el hallazgo 11 de la
          auditoría: 'CompletableFuture.supplyAsync(..., workers)' sobre hilos
          virtuales no lleva ni el MDC ni el contexto de traza, así que las 14
          líneas del catálogo salían sin correlationId — justo las que se
          buscan cuando un POST sale degradado.
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>context-propagation</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Utilidades de test de Spring Security: los post-processors que
          inyectan una autenticación en un pedido de MockMvc. Es lo que permite
          probar el 401, el 403 y —sobre todo— que el 404 de una reserva ajena
          sea indistinguible del de una inexistente.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Test de arquitectura: verifica que las dependencias entre capas no se violen. -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
          Testcontainers: los tests de integración corren contra un PostgreSQL
          real en Docker, que es la única forma de validar de verdad las
          migraciones de Flyway, los UNIQUE y el locking optimista. Van en la
          fase verify (failsafe) para que 'mvn test' siga sin necesitar Docker.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Awaitility: los tests del consumidor esperan un efecto que ocurre en
          OTRO hilo (el contenedor de listeners). Sin esto habría que poner
          Thread.sleep con un margen generoso, que es lento cuando pasa e
          intermitente cuando no. La versión la fija el BOM de Spring Boot.
        -->
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          RabbitMQ real en Docker para los tests de integración de mensajería.
          Es la única forma de validar lo que importa del broker y no se puede
          simular: los publisher confirms, el 'mandatory' sobre un exchange sin
          bindings, la TTL de la cola de espera y el dead-lettering. Va en la
          fase verify, como el de PostgreSQL, para que 'mvn test' siga sin
          necesitar Docker.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <!--
                      build-info: escribe META-INF/build-info.properties con la
                      versión y el instante del build. Es de dónde sale el campo
                      'version' obligatorio de cada registro de log (§1.2 del
                      diseño) y el 'version' de /actuator/info.

                      Sale del build y no de una constante a propósito: una
                      constante se olvida de actualizar y el log empieza a
                      mentir sobre qué artefacto produjo la línea, que es
                      justamente el dato con el que se decide si un incidente
                      lo introdujo el último despliegue.
                    -->
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!--
              'mvn test' corre sólo los unitarios (*Test): rápidos y sin Docker.
              'mvn verify' agrega los de integración (*IT), que necesitan Docker.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <!--
                      La salida de los tests va a archivo además de a consola.
                      Es lo que le da al gate de datos sensibles algo que
                      revisar: sin esto, la única forma de verificar que la
                      suite no escribe un email en claro es mirarla pasar, que
                      es exactamente lo que la auditoría hizo a mano y lo que
                      este paso viene a convertir en un paso del build.
                    -->
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <redirectTestOutputToFile>true</redirectTestOutputToFile>
                </configuration>
            </plugin>
            <!--
              El gate de datos sensibles, como paso de 'verify'.
              
              Corre DESPUÉS de failsafe —fase 'verify', que es la que sigue a
              'integration-test'— para poder mirar la salida de los tests de
              integración además de la de los unitarios.
              
              Los tests con ListAppender afirman sobre los registros que UNA
              prueba provoca; esto mira TODO lo que la suite escribió, incluido
              el arranque del contexto y las líneas que nadie está asertando.
              Son dos redes distintas y hacen falta las dos.
              
              'skip' con -Dpii.gate.skip=true para las plataformas sin 'sh'.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.plugin.version}</version>
                <executions>
                    <execution>
                        <id>pii-log-gate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <skip>${pii.gate.skip}</skip>
                            <executable>sh</executable>
                            <arguments>
                                <argument>${project.basedir}/scripts/pii-log-gate.sh</argument>
                                <argument>${project.build.directory}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-parameters</arg>
                        <!-- Se excluye 'serial': estas excepciones no se serializan. -->
                        <arg>-Xlint:all,-serial</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
